<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tf_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tf_widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/tf_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="2dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/tf_ic_train" />

        <TextView
            android:id="@+id/tf_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/tf_widget_label"
            android:textColor="@color/tf_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tf_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:maxLines="1"
            android:textColor="@color/tf_text_secondary"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/tf_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/tf_circle_bg"
            android:contentDescription="@string/tf_refresh"
            android:padding="6dp"
            android:src="@drawable/tf_ic_refresh" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tf_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/tf_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/tf_empty_hint"
        android:textColor="@color/tf_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
