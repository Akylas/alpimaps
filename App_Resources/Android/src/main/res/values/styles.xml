<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="Preference.SwitchPreferenceCompat.Material3"
        parent="@style/Preference.SwitchPreferenceCompat.Material">
    </style>
    <!-- the peak finder panel look: app background and 24dp top corners, matching the .bottomsheet css class -->
    <style name="ShapeAppearance.App.Panel" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">24dp</item>
    </style>
    <!-- overrides the textfield plugin's outlined box: the design's 12dp field corners -->
    <style name="TextInputLayout.Outlined" parent="@style/Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
    <style name="ModalBottomSheetDialog" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?android:attr/colorBackground</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Panel</item>
    </style>
    <style name="ModalBottomSheetDialogEInk" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?android:attr/colorBackground</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Panel</item>
        <!-- <item name="android:backgroundDimAmount">0</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowTranslucentStatus">false</item> -->
            <!-- <item name="android:background">@color/colorBackground</item> -->
    </style>

    <style name="FloatingActivityTheme.WindowTransition">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
    <style name="ThemeOverlay.App.BottomSheetDialog"
        parent="ThemeOverlay.Material3.DayNight.BottomSheetDialog">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="bottomSheetStyle">@style/ModalBottomSheetDialog</item>
    </style>
    <style name="ThemeOverlay.App.BottomSheetDialogEInk"
        parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="bottomSheetStyle">@style/ModalBottomSheetDialogEInk</item>
        <item name="android:backgroundDimAmount">0</item>
     </style>
    <!-- unmapped, M3 would paint dialogs with its baseline purple surface -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">?android:attr/colorBackground</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.App.Panel</item>
    </style>
